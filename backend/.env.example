# ---------- Server ----------
PORT=4000
NODE_ENV=development
# Asal frontend tambahan yang diizinkan, pisahkan dengan koma.
# Kosongkan bila frontend disajikan oleh server ini sendiri (kasus umum).
# Akses seasal — termasuk lewat alamat IP dari PC lain — selalu diizinkan.
CORS_ORIGIN=

# ---------- Keamanan ----------
# WAJIB diganti di produksi dengan string acak panjang
JWT_SECRET=ganti-dengan-secret-acak-yang-panjang-dan-rahasia
JWT_EXPIRES_IN=8h

# ---------- Database ----------
# sqlite (default, tanpa instalasi) | mysql
DB_DRIVER=sqlite

# Dipakai bila DB_DRIVER=sqlite
SQLITE_FILE=./data/klinik.db

# Dipakai bila DB_DRIVER=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=klinik_gigi_manda

# ---------- Identitas Klinik (tercetak di kwitansi) ----------
CLINIC_NAME=Klinik Gigi Manda
CLINIC_TAGLINE=Perawatan Gigi & Mulut Terpadu
CLINIC_ADDRESS=Jl. Contoh Raya No. 123, Kota, Provinsi 12345
CLINIC_PHONE=(021) 1234-5678
CLINIC_EMAIL=info@klinikgigimanda.id
CLINIC_LOGO=./storage/logo.png

# ---------- Kwitansi ----------
RECEIPT_PREFIX=KGM
# Jumlah digit nomor urut per bulan, mis. 4 -> KGM/202608/0001
RECEIPT_SEQ_PAD=4

# ---------- Akun admin awal (dibuat saat seed) ----------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Administrator Klinik

# Isi tarif layanan contoh saat database masih kosong.
# Biarkan false untuk klinik sungguhan — tarif contoh berisi harga karangan.
# Setel true hanya untuk demo atau pengembangan.
SEED_SAMPLE_SERVICES=false

# ---------- Pembatasan akses jaringan ----------
# Daftar IP komputer yang boleh membuka aplikasi, dipisah koma.
# Kosongkan untuk mengizinkan semua komputer di jaringan.
# Komputer server sendiri (localhost) selalu diizinkan.
# Contoh 2 PC klinik : ALLOWED_IPS=192.168.18.2,192.168.18.3
# Contoh satu subnet : ALLOWED_IPS=192.168.18.0/24
ALLOWED_IPS=

# Nyalakan HANYA bila server berada di belakang reverse proxy (Nginx/Caddy).
# Bila menyala tanpa proxy, alamat asal bisa dipalsukan lewat header.
TRUST_PROXY=false
